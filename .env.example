# Copiez ce fichier en « .env » puis remplacez chaque valeur. Ne partagez jamais le fichier .env.

# Mot de passe de la base de données (inventez-le, il ne sert qu'à l'application)
DB_PASSWORD=remplacez-moi-par-un-mot-de-passe-long

# Clé secrète des connexions : 32 caractères minimum, au hasard
JWT_SECRET=remplacez-moi-par-une-longue-cle-secrete-de-32-caracteres-ou-plus

# Premier compte dirigeant, créé au tout premier démarrage (changez le mot de passe ensuite dans « Mon compte »)
ADMIN_EMAIL=contact@mon-entreprise.dz
ADMIN_PASSWORD=Changez-Moi-2026!

# Adresse du site (pour un ordinateur local : http://localhost)
SITE_URL=http://localhost

# Port du site sur la machine (80 par défaut)
HTTP_PORT=80
